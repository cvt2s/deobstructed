				local function setVal(v)
					v = math.clamp(math.round(v), min, max)
					val = v
					local p = (v - min) / (max - min)
					fill.Size = UDim2.new(p, 0, 1, 0)
					knob.Position = UDim2.new(p, -6, 0.5, -6)
					valLabel.Text = tostring(v)
					pcall(callback, v)

local function startAutoFarm()
	tbl2.died = false
	local player = LocalPlayer

	coroutine.wrap(function()
		while _G.AutoFarming do
			pcall(function()
				if player.Character.Humanoid.Health > 0 and player.Character.HumanoidRootPart and player.Character.Remotes.KeyEvent then
					if _G.CurrentSettings.AutoArata and not findobj(player.Character, "Arata") then
						pressArataKey("Zero")
					end
					if _G.CurrentSettings.AutoMask and not player.PlayerFolder.Mask.Value then
						pressArataKey("M")
					end
					if not findobj(player.Character, "Kagune") and not findobj(player.Character, "Quinque") then
						pressArataKey(stages[tonumber(_G.CurrentSettings.Stages)])
					end

					if _G.CurrentSettings.AutoQuest and (
						not findobj(player.PlayerFolder.CurrentQuest.Complete, "Aogiri Member")
						or player.PlayerFolder.CurrentQuest.Complete["Aogiri Member"].Value == player.PlayerFolder.CurrentQuest.Complete["Aogiri Member"].Max.Value
					) then
						teleportToYoshimura(true)
						return
					end

					if _G.CurrentSettings.AutoCashOut and tick() - oldtick > 7200 then
						teleportToYoshimura()
					end

					local character = findBestTarget()
					if character then
						foundnew = false
						_G.reachednpc = false

						coroutine.wrap(function()
							while _G.reachednpc do
								if character ~= findBestTarget() then foundnew = true; return end
								task.wait(0.1)
							end
						end)()

						local isBoss = _G.CurrentSettings.Boss[character.Name]
						local method = isBoss and _G.CurrentSettings.BossMethod or _G.CurrentSettings.NPCMethod
						local dist = isBoss and _G.CurrentSettings.DistanceFromBoss or _G.CurrentSettings.DistanceFromNpc

						local dirX = method ~= "Above" and method ~= "In Front" and -1 or 1
						local dirY = method ~= "Above" and method ~= "In Front" and 1 or -1

						local targetCF = method == "Above" or method == "Under"
							and CFrame.new(character.HumanoidRootPart.Position) * CFrame.Angles(math.rad(dirY * 90), 0, 0) + Vector3.new(0, dirX * dist, 0)
							or character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(method ~= "In Front" and 0 or 180), 0) + character.HumanoidRootPart.CFrame.lookVector * (dirX * dist)

						TP1(targetCF)

						spawn(function()
							pcall(function()
								ReplicatedStorage.Remotes.UpdateCharData:FireServer(
									CFrame.lookAt(
										Vector3.new(player.Character.HumanoidRootPart.Position.X, character.HumanoidRootPart.Position.Y, player.Character.HumanoidRootPart.Position.Z),
										Vector3.new(character.HumanoidRootPart.Position.X, character.HumanoidRootPart.Position.Y, character.HumanoidRootPart.Position.Z)
									),
									workspace.CurrentCamera:WorldToScreenPoint(character.HumanoidRootPart.Position),
									targetCF,
									nil
								)
							end)
						end)

						_G.reachednpc = true

						if not foundnew then
							_G.SafeZoning = isInSafeZone(character.HumanoidRootPart)

							while findobj(findobj(character.Parent, character.Name), "Head")
								and player.Character.Humanoid.Health > 0
								and _G.AutoFarming
								and (not _G.CurrentSettings.AntiSafeZone or not _G.SafeZoning)
							do
								_G.SafeZoning = isInSafeZone(character.HumanoidRootPart)

								if _G.CurrentSettings.AutoArata and not findobj(player.Character, "Arata") then
									pressArataKey("Zero")
								end
								if _G.CurrentSettings.AutoMask and not player.PlayerFolder.Mask.Value then
									pressArataKey("M")
								end
								if not findobj(player.Character, "Kagune") and not findobj(player.Character, "Quinque") then
									pressArataKey(stages[tonumber(_G.CurrentSettings.Stages)])
								end

								local skillSet = isBoss and _G.CurrentSettings.Skills or _G.CurrentSettings.SkillsNPC
								for k, v in pairs(skillSet) do
									if player.PlayerFolder.CanAct.Value and v and skills[k].Value ~= "DownTime" then
										pressArataKey(k)
									end
								end

								if isInSafeZone(player.Character.HumanoidRootPart) then
									player.Character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame
										* CFrame.Angles(0, math.rad(method == "In Front" and 0 or 180), 0)
										+ character.HumanoidRootPart.CFrame.lookVector * ((method ~= "In Front" and 1 or -1) * dist)
								elseif method ~= "Above" and method ~= "Under" then
									player.Character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame
										* CFrame.Angles(0, math.rad(method ~= "In Front" and 0 or 180), 0)
										+ character.HumanoidRootPart.CFrame.lookVector * (dirX * dist)
								else
									player.Character.HumanoidRootPart.CFrame = CFrame.new(character.HumanoidRootPart.Position)
										* CFrame.Angles(math.rad(dirY * 90), 0, 0)
										+ Vector3.new(0, dirX * dist, 0)
								end

								spawn(function()
									pcall(function()
										ReplicatedStorage.Remotes.UpdateCharData:FireServer(
											CFrame.lookAt(
												Vector3.new(player.Character.HumanoidRootPart.Position.X, character.HumanoidRootPart.Position.Y, player.Character.HumanoidRootPart.Position.Z),
												Vector3.new(character.HumanoidRootPart.Position.X, character.HumanoidRootPart.Position.Y, character.HumanoidRootPart.Position.Z)
											),
											workspace.CurrentCamera:WorldToScreenPoint(character.HumanoidRootPart.Position),
											player.Character.HumanoidRootPart.CFrame,
											nil
										)
									end)
								end)

								if player.PlayerFolder.CanAct.Value then
									pressArataKey("Mouse1")
								end

								task.wait()
							end

							if character.Name == "Gyakusatsu" then
								player.Character.Humanoid.Health = 0
							end

							if _G.CurrentSettings.EatCorpse
								and _G.AutoFarming
								and player.Character.Humanoid.Health > 0
								and character.Name ~= "Eto Yoshimura"
								and not findobj(character.Parent, "Gyakusatsu")
								and character.Name ~= "Gyakusatsu"
							then
								pcall(function()
									repeat
										corpseClickFarm(character)
										wait()
									until not character:FindFirstChild(character.Name .. " Corpse")
								end)
								return
							end
						end
					end
				else
					tbl2.died = true
				end
			end)
			wait()
		end
	end)()
end


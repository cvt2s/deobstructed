	self.FOVCircleFrame.Size = UDim2.new(0, radius * 2, 0, radius * 2)
	local corner = self.FOVCircleFrame:FindFirstChildOfClass("UICorner")
	if corner then corner.CornerRadius = UDim.new(0, radius) end
end


_G.OnBossSpawn = function(name, states)
	statusLabel:Set("⬆ " .. name .. " spawned!")
end

_G.OnBossDead = function(name, states)
	statusLabel:Set("⬇ " .. name .. " died")
end

local function refreshBossStatus()
	local alive = {}
	for name, state in pairs(bossStates) do
		if state then table.insert(alive, name) end
	end
	if #alive > 0 then
		statusLabel:Set("Active: " .. table.concat(alive, ", "))
	else
		statusLabel:Set("No bosses alive")
	end
end

CombatTab:Section("Actions"):Button("Refresh Bosses", refreshBossStatus)


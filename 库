				corner(3, track)

				local pct = math.clamp((val - min) / (max - min), 0, 1)
				local fill = mk("Frame", {
					Size = UDim2.new(pct, 0, 1, 0),
					BackgroundColor3 = CYAN,
					BorderSizePixel = 0,
				}, track)
				corner(3, fill)


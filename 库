	local done = false
	tween.Completed:Connect(function() done = true end)

	while not done do
		if foundnew or not _G.AutoFarming or LocalPlayer.Character.Humanoid.Health <= 0 then
			tween:Cancel()
			break
		end
		LocalPlayer.Character.HumanoidRootPart.CFrame = CFrameValue.Value

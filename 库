			function sec:Slider(label, min, max, default, callback)
				local val = default or min
				local row = mk("Frame", {
					Size = UDim2.new(1, 0, 0, 38),
					BackgroundTransparency = 1,
				}, secFrame)

				local topRow = mk("Frame", {

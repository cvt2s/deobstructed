			LocalPlayer.Character.HumanoidRootPart.CFrame.X,
			cframe.Y,
			LocalPlayer.Character.HumanoidRootPart.CFrame.Z
		)
	end

	if LocalPlayer.Character.Humanoid.Sit then
		LocalPlayer.Character.Humanoid.Sit = false
	end

	local CFrameValue = Instance.new("CFrameValue")
	CFrameValue.Value = LocalPlayer.Character.HumanoidRootPart.CFrame

	local tween = TweenService:Create(
		CFrameValue,
		TweenInfo.new(
			(LocalPlayer.Character.HumanoidRootPart.Position - cframe.p).magnitude / _G.TweenSpeed,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{ Value = cframe }

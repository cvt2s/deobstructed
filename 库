local function reformatint(str)
	str = tostring(str)
	for i = 1, math.floor((string.len(str) - 1) / 3) do
		str = string.sub(str, 1, -3 * i - i) .. "," .. string.sub(str, -3 * i - i + 1)
	end
	return str
end

local function deepCopyTable(tbl)
	if type(tbl) ~= "table" then return tbl end
	local copy = {}
	for k, v in pairs(tbl) do
		copy[k] = type(v) == "table" and deepCopyTable(v) or v
	end
	return copy
end

local function getCache(base, override)
	local copy = deepCopyTable(base)
	if type(override) ~= "table" then return copy end
	for k, v in pairs(override) do
		if type(v) == "table" and type(copy[k]) == "table" then
			copy[k] = getCache(copy[k], v)
		else
			copy[k] = v
		end
	end
	return copy
end

local function mergeTables(target, source)
	local copy = {}
	for k, v in pairs(source) do copy[k] = v end
	for k, v in pairs(target) do
		if type(v) == "table" and type(copy[k]) == "table" then
			copy[k] = mergeTables(v, copy[k])
		else
			copy[k] = v
		end
	end
	return copy
end

local function findobj(instance, name)
	return instance:FindFirstChild(name)
end

local function findobjofclass(instance, className)
	return instance:FindFirstChildOfClass(className)
end

local function waitforobj(instance, name, timeout)
	if timeout then return instance:WaitForChild(name, timeout) end
	return instance:WaitForChild(name)
end

local function isInSafeZone(part)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.SafeZones }
	if workspace:Raycast(part.Position, Vector3.new(0, -25, 0), params) then
		return true
	end
	return false
end


local function iterateTable(_, callback, arg, arg2)
	if type(callback) == "table" then
		local mt = getmetatable(callback)
		if mt and mt.__iter then
			local v, v2, v3 = mt.__iter(callback)
			callback = v; arg = v2; arg2 = v3
		else
			arg = callback; arg2 = nil; callback = next
		end
	end
	return coroutine.wrap(function()
		while true do
			local v = table.pack(callback(arg, arg2))
			arg2 = v[1]
			if arg2 == nil then break end
			coroutine.yield(true, table.unpack(v, 1, v.n))
		end
	end)
end

local function findBestTarget()
	local result
	local huge = math.huge
	local bossLevelReq = {
		["Eto Yoshimura"] = 1250,
		["Koutarou Amon"] = 750,
		["Nishiki Nishio"] = 250,
		["Touka Kirishima"] = 250,
		Fighter = 50
	}

	local hrp = LocalPlayer.Character.HumanoidRootPart
	local hrpPos = hrp.Position
	local playerLevel = tonumber(LocalPlayer.PlayerFolder.Stats.Level.Value)

	local v, v2, v3 = pairs(workspace.NPCSpawns:GetChildren())
	local iter = iterateTable(nil, v, v2, v3)

	while true do
		local row = table.pack(iter())
		if not row[1] then break end

		local spawn = row[3]
		local character = findobjofclass(spawn, "Model")
		if not character or not findobj(character, "Head") or findobj(character, "AC") then continue end

		local name = character.Name
		local npcPos = character.HumanoidRootPart.Position

		if _G.CurrentSettings.Boss[name] and playerLevel >= bossLevelReq[name] then
			if not _G.CurrentSettings.AntiSafeZone then return character end
			if not isInSafeZone(character.HumanoidRootPart) then return character end
		end

		if spawn.Name ~= tbl2.npcs[_G.CurrentSettings.NPCTarget] then continue end

		local NPCLevel = _G.CurrentSettings.NPCLevel
		local valid = false

		if _G.CurrentSettings.NPCTarget ~= "Humans" then
			if NPCLevel.Low and string.find(name, "Low") and not string.find(name, "1") then valid = true end
			if NPCLevel.Mid and string.find(name, "Mid") and not string.find(name, "2") then valid = true end
			if NPCLevel.High and string.find(name, "High") and not string.find(name, "First") then valid = true end
			if not NPCLevel.Low and not NPCLevel.Mid and not NPCLevel.High then valid = true end
		else
			valid = true
		end

		if valid and (not _G.CurrentSettings.AntiSafeZone or not isInSafeZone(character.HumanoidRootPart)) then
			local mag = (npcPos - hrpPos).Magnitude
			if mag < huge then
				result = character
				huge = mag
			end
		end
	end

	return result
end

local function getCharacter()
	local Character
	local huge = math.huge

	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrpPos = LocalPlayer.Character.HumanoidRootPart.Position

		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer
				and table.find(_G.PlayersToFarm or {}, player.Name)
				and player.Character
				and player.Character:FindFirstChild("HumanoidRootPart")
			then
				local pos2 = player.Character.HumanoidRootPart.Position
				if isNearAnyOOB(pos2) then
					local mag = (pos2 - hrpPos).Magnitude
					if mag < huge then
						huge = mag
						Character = player.Character
					end
				end
			end
		end
	end

	return Character
end


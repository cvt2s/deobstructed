		end)
	end

	local data = game.HttpService:JSONDecode(
		game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
	)

	for _, server in pairs(data.data) do
		local jobId = tostring(server.id)
		if server.playing == nil or server.playing == "null" then server.playing = 0 end

		if tonumber(server.maxPlayers) > tonumber(server.playing) then
			local alreadyVisited = false
			for _, entry in pairs(visited) do
				if jobId == tostring(entry) then
					alreadyVisited = true
					break
				end
			end

			if not alreadyVisited then
				table.insert(visited, jobId)
				wait()
				pcall(function()
					writefile("PorryHopperServers.porry", HttpService:JSONEncode(visited))
					wait()
					TeleportService:TeleportToPlaceInstance(PlaceId, jobId, LocalPlayer)
				end)
				wait(4)
			end
		end
	end
end

local function HopServer(setting)
	local key = setting or "PorryHopper"
	TeleportService:SetTeleportSetting(key, true)

	if _G.CurrentSettings and _G.CurrentSettings.Webhook and _G.CurrentSettings.Webhook.URL then
		TeleportService:SetTeleportSetting("PorryWebhook", _G.CurrentSettings.Webhook.URL)
	end

	while wait() do
		pcall(function()
			TPReturner()
		end)
	end
end


			and (cframe.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 100
		then
			tween:Cancel()
			LocalPlayer.Character.HumanoidRootPart.CFrame = cframe
			break
		end
		task.wait()
	end

	CFrameValue:Destroy()
end

